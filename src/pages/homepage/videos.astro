---
const assetBase = import.meta.env.BASE_URL;
const videos = [
	{ image: `${assetBase}/assets/album-art.png`, alt: "Trust Us, We Lie artwork for a music video", title: "Music Videos", videoId: "3U3kfb3V0xY" },
	{ image: `${assetBase}/assets/band-promo.jpg`, alt: "A Heartwell Ending band photo for a live video", title: "Live Videos", videoId: "W0k5VxFxCqc" },
];
---

<section class="box videos-box" id="videos">
	<h2>Video <em>gallery</em></h2>
	<div class="section-intro"><p>Music videos, live clips, and old footage will live here.</p></div>
	<div class="video-grid">
		{videos.map((video) => (
			<div class="media-tile">
				<button class="video-trigger" type="button" data-modal="video" data-title={video.title} data-video-id={video.videoId} aria-label={`Play ${video.title}`}>
					<span class="video-thumb"><img src={video.image} alt={video.alt} /><span class="play-badge" aria-hidden="true">▶</span></span>
					<span class="video-trigger-title">{video.title}</span>
				</button>
			</div>
		))}
	</div>
</section>
