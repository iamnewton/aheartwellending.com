---
const tracks = [
	"If Looks Could Kill",
	"The Secret Between The Sheets",
	"One More Song For Your MySpace Page",
	"Trust Us, We Lie",
];
---
<section class="box player-box" id="music">
	<h2>Heartwell <em>music player</em></h2>
	<div class="box-body">
		<div class="player">
			<div class="player-head">
				<img class="player-art" src="/assets/album-art.png" alt="Trust Us, We Lie album artwork" />
				<div><div class="player-title" id="now-playing">{tracks[0]}</div><div class="player-sub">A Heartwell Ending · playlist</div></div>
			</div>
			<div class="player-buttons">
				<button id="prev-track" aria-label="Previous track">⏮</button>
				<button id="play-track" aria-label="Play selected song">▶</button>
				<button id="next-track" aria-label="Next track">⏭</button>
				<div class="progress" aria-hidden="true"><span></span></div>
			</div>
			<div class="player-note" id="player-note">Select a song below.</div>
			<ol class="tracklist" id="tracklist">
				{tracks.map((track, index) => <li><button class:list={{ active: index === 0 }} data-track={index} data-track-title={track}><span>{String(index + 1).padStart(2, "0")}</span> {track}</button></li>)}
			</ol>
		</div>
	</div>
</section>
