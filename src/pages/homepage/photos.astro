---
const assetBase = import.meta.env.BASE_URL;
const photos = Array.from({ length: 24 }, (_, index) => {
	const number = index + 1;
	return {
		image: `${assetBase}/assets/images/photo-gallery/ahe-${number}.jpg`,
		alt: `A Heartwell Ending photo ${number}`,
		title: `Photo ${number}`,
	};
});
---

<section class="box photos-box" id="photos">
	<h2>Photo <em>gallery</em></h2>
	<div class="section-intro"><p>Photos from A Heartwell Ending.</p></div>
	<div class="gallery-carousel" data-photo-carousel>
		<div class="gallery-grid" data-photo-track aria-live="polite">
			{photos.map((photo, index) => (
				<article class="media-tile gallery-slide" data-photo-slide data-photo-index={index}>
					<button class="photo-open" type="button" data-modal="photo" data-image={photo.image} data-title={photo.title} aria-label={`View ${photo.alt} larger`}>
						<img src={photo.image} alt={photo.alt} loading={index < 2 ? "eager" : "lazy"} />
						<span class="photo-open-label">View larger</span>
					</button>
				</article>
			))}
		</div>
		<div class="gallery-controls" aria-label="Photo gallery navigation">
			<button class="gallery-arrow" type="button" data-photo-previous aria-label="Previous photos">←</button>
			<span class="gallery-count" data-photo-count aria-live="polite"></span>
			<button class="gallery-arrow" type="button" data-photo-next aria-label="Next photos">→</button>
		</div>
	</div>
</section>
