---
const assetBase = import.meta.env.BASE_URL;
const products = [
	{ image: `${assetBase}/assets/images/merch/ribcage-tee.jpg`, alt: "Black A Heartwell Ending ribcage shirt", title: "Ribcage tee", detail: "Black shirt" },
	{ image: `${assetBase}/assets/images/merch/trust-us-tee.jpg`, alt: "Off-white Trust Us, We Lie calla lily shirt", title: "Trust Us, We Lie tee", detail: "Off-white shirt" },
	{ image: `${assetBase}/assets/images/merch/vinyl-angle.jpg`, alt: "Trust Us, We Lie purple vinyl record", title: "Trust Us, We Lie vinyl", detail: "Purple record" },
	{ image: `${assetBase}/assets/images/merch/cd-open.jpg`, alt: "Trust Us, We Lie CD jewel case", title: "Trust Us, We Lie CD", detail: "Physical CD" },
];
---

<section class="box merch-box" id="merch">
	<h2>Merch <em>Shop</em></h2>
	<div class="section-intro"><p>Shirts and physical releases from the Heartwell collection.</p></div>
	<div class:list={["merch-carousel", { "has-overflow": products.length > 4 }]} data-merch-carousel>
		{products.length > 4 && <button class="merch-carousel-arrow previous" type="button" data-merch-previous aria-label="Previous merch items">‹</button>}
		<div class="merch-grid" data-merch-track>
			{products.map((product) => (
				<article class="product">
					<button class="product-open" type="button" data-modal="merch" data-image={product.image} data-detail={product.detail} data-title={product.title} aria-label={`View ${product.title}`}>
						<img src={product.image} alt={product.alt} />
						<h3>{product.title}</h3>
						<p>{product.detail}</p>
						{/* <span class="product-open-label">View item »</span> */}
					</button>
				</article>
			))}
		</div>
		{products.length > 4 && <button class="merch-carousel-arrow next" type="button" data-merch-next aria-label="Next merch items">›</button>}
	</div>
</section>
