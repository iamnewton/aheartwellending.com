---
const assetBase = import.meta.env.BASE_URL;
---
<section class="box feature-box">
	<h2>Featured <em>update</em></h2>
	<div class="box-body featured">
		<img class="feature-art" src={`${assetBase}/assets/band-promo.jpg`} alt="A Heartwell Ending band promo photo" />
		<div>
			<span class="tag">A Heartwell Ending</span>
			<h1>Trust Us,<br />We Lie.</h1>
			<p>The songs you kept on your profile. The people you met in the comments. Pick a track, leave a message, and stay awhile.</p>
			<a class="feature-link" href="#music">Open the music player →</a>
		</div>
	</div>
</section>
