---
---

<section class="box chat-box" id="chat">
	<h2 class="server-card-title">
		<span>Your Friends <em>Are Here</em></span>
		<span class="server-status-led" aria-hidden="true"></span>
	</h2>
	<div class="section-intro">
		<div>
			<p class="server-card-kicker">CURRENTLY HANGING OUT AT</p>
			<div id="discord-server-name">A Heartwell Ending's server</div>
		</div>
		<p class="presence-counter"><strong id="discord-presence-count">—</strong><span>online</span></p>
	</div>
	<div class="box-body" id="discord-server-card" aria-live="polite">
		<p class="server-card-note" id="discord-server-note">Loading who's around…</p>
		<div class="online-friends" id="discord-online-friends" aria-label="Members currently online"></div>
		<a class="solid-button server-join-button" href="https://discord.gg/AV7HSVb8b" target="_blank" rel="noopener noreferrer">Join the server »</a>
		<p class="server-updated" id="discord-server-updated">Connecting to the Discord widget API…</p>
	</div>
</section>
