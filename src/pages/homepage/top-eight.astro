---
const assetBase = import.meta.env.BASE_URL;
const topFriends = [
	{ name: "Tom", image: `${assetBase}/assets/images/tom.png` },
	{ name: "You?" },
	{ name: "Your band" },
	{ name: "Old friends" },
	{ name: "New friends" },
	{ name: "The scene" },
	{ name: "Long Beach" },
	{ name: "Everyone" },
];
---

<section class="box top-box" id="top8">
	<h2>Heartwell's <em>Top 8</em></h2>
	<div class="box-body">
		<div class="top-eight">
			{topFriends.map((friend, index) => (
				<div class="friend">
					{friend.image
						? <img class="friend-image" src={friend.image} alt={friend.name} loading="lazy" />
						: <div class="avatar">{String(index + 1).padStart(2, "0")}</div>
					}
					<span>{friend.name}</span>
				</div>
			))}
		</div>
	</div>
</section>
