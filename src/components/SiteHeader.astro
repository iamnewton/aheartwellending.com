---
import { navigationLinks } from "./navigation.js";
---
<div class="utility">
	<span><strong>A Heartwell Ending</strong> / official profile</span>
</div>
<header class="banner">
	<div class="banner-brand">
		<img class="banner-logo" src="assets/heartwell-logo.png" alt="A Heartwell Ending">
		<span class="banner-sub">LONG BEACH, CALIFORNIA / EST. 2003</span>
	</div>
	<img class="banner-album" src="assets/album-art.png" alt="Trust Us, We Lie album artwork with purple calla lily">
	<span class="banner-stamp">last login: forever ago</span>
</header>
<nav class="main-nav" aria-label="Main navigation">
  {navigationLinks.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>
<div class="welcome">
	<span>You are viewing A Heartwell Ending's profile.</span>
	<span>Long Beach, CA · Music, photos, and your Top 8.</span>
</div>
