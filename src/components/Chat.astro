<section class="box chat-box" id="chat">
	<h2>Heartwell <em>chat room</em></h2>
	<div class="chat-window">
		<div class="chat-title"><span>♥ AHE_group_chat.exe</span><span class="window-controls">_ □ ×</span></div>
		<div class="chat-messages" id="chat-messages" aria-live="polite">
			<p class="system">*** Write a message, then open Discord to share it with the community. ***</p>
			<p id="chat-status" class="system" role="status">Your draft stays here while you join Discord.</p>
		</div>
		<form class="chat-form" id="chat-form" data-discord-invite="https://discord.gg/AV7HSVb8b">
			<input id="chat-input" maxlength="200" placeholder="Say something..." aria-label="Chat message" required />
			<button type="submit">Send</button>
		</form>
	</div>
	<p class="hint chat-hint">Send copies your message and opens the Heartwell Discord. Paste it into the chat after you join.</p>
</section>
